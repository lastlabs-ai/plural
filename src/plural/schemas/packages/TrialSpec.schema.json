{
  "$defs": {
    "EnvironmentIdentity": {
      "additionalProperties": false,
      "description": "Exact Environment revision identity.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "EnvironmentIdentity",
      "type": "object"
    },
    "HarnessBinding": {
      "additionalProperties": false,
      "description": "Exact harness revision.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "HarnessBinding",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessGrant": {
      "additionalProperties": false,
      "description": "Effective harness tool policy for one Trial.\n\nComputed when an Agent binds to a Task Environment. The Environment may\nonly subtract harness tools; it does not own or wrap the model.",
      "properties": {
        "declared": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Declared",
          "type": "array",
          "uniqueItems": true
        },
        "denial_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Denial Reasons",
          "type": "object"
        },
        "denied": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Denied",
          "type": "array",
          "uniqueItems": true
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentIdentity"
        },
        "granted": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Granted",
          "type": "array",
          "uniqueItems": true
        },
        "harness": {
          "$ref": "#/$defs/HarnessBinding"
        }
      },
      "required": [
        "environment",
        "harness",
        "declared",
        "granted",
        "denied"
      ],
      "title": "HarnessGrant",
      "type": "object"
    },
    "JobMode": {
      "description": "Execution mode.",
      "enum": [
        "eval",
        "train"
      ],
      "title": "JobMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One independent Agent attempt.",
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentIdentity"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "harness_grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessGrant"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/JobMode"
    },
    "placement": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Placement",
      "type": "object"
    },
    "runtime_provider": {
      "title": "Runtime Provider",
      "type": "string"
    },
    "task_digest": {
      "title": "Task Digest",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verifier_digests": {
      "items": {
        "type": "string"
      },
      "title": "Verifier Digests",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "agent_id",
    "agent_name",
    "task_id",
    "task_digest",
    "attempt",
    "environment",
    "verifier_digests",
    "mode",
    "runtime_provider"
  ],
  "title": "TrialSpec",
  "type": "object"
}
