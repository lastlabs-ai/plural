{
  "$defs": {
    "EnvironmentIdentity": {
      "additionalProperties": false,
      "description": "Exact identity and revision for a packaged environment.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "EnvironmentIdentity",
      "type": "object"
    },
    "HarnessBinding": {
      "additionalProperties": false,
      "description": "Exact harness binding used by one agent and every resulting trial.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "HarnessBinding",
      "type": "object"
    },
    "RuntimeSpec": {
      "additionalProperties": false,
      "description": "Requested execution target. Image, network, and resources live on the environment.",
      "properties": {
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "unsafe_local": {
          "default": false,
          "title": "Unsafe Local",
          "type": "boolean"
        }
      },
      "title": "RuntimeSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One independent attempt for one agent and environment-owned task.",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "agent_name": {
      "minLength": 1,
      "title": "Agent Name",
      "type": "string"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentIdentity"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "instance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instance Id"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeSpec"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "agent_id",
    "agent_name",
    "task_id",
    "attempt",
    "environment",
    "runtime"
  ],
  "title": "TrialSpec",
  "type": "object"
}
