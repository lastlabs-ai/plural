{
  "$defs": {
    "ErrorCode": {
      "description": "Stable execution failure categories.",
      "enum": [
        "authentication",
        "configuration",
        "invalid_request",
        "rate_limited",
        "provider_unavailable",
        "timeout",
        "runtime_unavailable",
        "harness_failed",
        "protocol_failed",
        "environment_failed",
        "verifier_failed",
        "evidence_missing",
        "artifact_failed",
        "lock_incompatible",
        "tito_unsupported",
        "cancelled",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ExecutionStatus": {
      "description": "Durable TrialExecution state machine.",
      "enum": [
        "queued",
        "provisioning",
        "running",
        "verifying",
        "awaiting_review",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One retry execution of a Trial.",
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "minimum": 0,
      "title": "Execution Id",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "trial_id",
    "execution_id",
    "status"
  ],
  "title": "TrialExecution",
  "type": "object"
}
