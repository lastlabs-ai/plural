{
  "$defs": {
    "EnvironmentIdentity": {
      "additionalProperties": false,
      "description": "Exact identity and revision for a packaged environment.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "EnvironmentIdentity",
      "type": "object"
    },
    "FileDeclaration": {
      "additionalProperties": false,
      "description": "One exact file a harness or verifier may emit or consume.",
      "properties": {
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileDeclaration",
      "type": "object"
    },
    "HarnessBinding": {
      "additionalProperties": false,
      "description": "Exact harness binding used by one agent and every resulting trial.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "HarnessBinding",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "Actions a stamped harness may request.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessManifest": {
      "additionalProperties": false,
      "description": "Public manifest for a single-agent harness package.\n\nA ``declared`` harness can be stamped and inspected but cannot execute a\ntrial. A ``runnable`` harness must provide a command.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "auth_modes": {
          "default": [
            "environment"
          ],
          "items": {
            "enum": [
              "environment",
              "api_key",
              "oauth",
              "none"
            ],
            "type": "string"
          },
          "title": "Auth Modes",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "environment_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Environment Names",
          "type": "array"
        },
        "healthcheck": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck"
        },
        "implementation": {
          "default": "declared",
          "enum": [
            "declared",
            "runnable"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Outputs",
          "type": "array"
        },
        "protocol": {
          "default": "plural-harness-v1",
          "enum": [
            "plural-harness-v1",
            "acp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "protocol_adapter": {
          "anyOf": [
            {
              "const": "acp-client-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Adapter"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secret Names",
          "type": "array"
        },
        "supported_models": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Supported Models",
          "type": "array"
        },
        "trajectory_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Path"
        },
        "version": {
          "default": "0.1.0",
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "HarnessManifest",
      "type": "object"
    },
    "HarnessPackage": {
      "additionalProperties": false,
      "description": "Content-addressed harness manifest and source.",
      "properties": {
        "manifest": {
          "$ref": "#/$defs/HarnessManifest"
        },
        "source": {
          "$ref": "#/$defs/PackageSource"
        }
      },
      "required": [
        "manifest",
        "source"
      ],
      "title": "HarnessPackage",
      "type": "object"
    },
    "HarnessStamp": {
      "additionalProperties": false,
      "description": "Frozen result of stamping one harness onto one environment revision.",
      "properties": {
        "declared": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Declared",
          "type": "array",
          "uniqueItems": true
        },
        "denial_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Denial Reasons",
          "type": "object"
        },
        "denied": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Denied",
          "type": "array",
          "uniqueItems": true
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentIdentity"
        },
        "granted": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Granted",
          "type": "array",
          "uniqueItems": true
        },
        "harness": {
          "$ref": "#/$defs/HarnessBinding"
        }
      },
      "required": [
        "environment",
        "harness",
        "declared",
        "granted",
        "denied"
      ],
      "title": "HarnessStamp",
      "type": "object"
    },
    "PackageSource": {
      "additionalProperties": false,
      "description": "Immutable source for a harness package.\n\nPublished and remote sources require a digest. An unsigned local source is\naccepted only when explicitly marked unsafe. ``trusted`` is retained only\nfor manifest migration and never bypasses digest or unsafe checks.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "local",
            "oci",
            "archive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trusted": {
          "default": false,
          "title": "Trusted",
          "type": "boolean"
        },
        "unsafe_local": {
          "default": false,
          "title": "Unsafe Local",
          "type": "boolean"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "PackageSource",
      "type": "object"
    },
    "RoutingSpec": {
      "additionalProperties": false,
      "description": "Portable model routing configuration for an agent.",
      "properties": {
        "fallback_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "title": "RoutingSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable model + environment configuration, optionally with a stamped harness.",
  "properties": {
    "auth_mode": {
      "default": "environment",
      "enum": [
        "environment",
        "api_key",
        "oauth",
        "none"
      ],
      "title": "Auth Mode",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentIdentity"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "harness_package": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessPackage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "routing": {
      "$ref": "#/$defs/RoutingSpec"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_names": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    },
    "stamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessStamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "model",
    "environment"
  ],
  "title": "AgentTemplate",
  "type": "object"
}
