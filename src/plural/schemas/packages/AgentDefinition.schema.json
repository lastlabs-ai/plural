{
  "$defs": {
    "FileDeclaration": {
      "additionalProperties": false,
      "description": "A file emitted or consumed by a package.",
      "properties": {
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileDeclaration",
      "type": "object"
    },
    "HarnessBinding": {
      "additionalProperties": false,
      "description": "Exact harness revision.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "HarnessBinding",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessDefinition": {
      "additionalProperties": false,
      "description": "Versioned executable harness contract.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "auth_modes": {
          "default": [
            "environment"
          ],
          "items": {
            "enum": [
              "environment",
              "api_key",
              "oauth",
              "none"
            ],
            "type": "string"
          },
          "title": "Auth Modes",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "environment_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Environment Names",
          "type": "array"
        },
        "healthcheck": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck"
        },
        "implementation": {
          "default": "declared",
          "enum": [
            "declared",
            "runnable"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Outputs",
          "type": "array"
        },
        "protocol": {
          "default": "plural-harness-v1",
          "enum": [
            "plural-harness-v1",
            "acp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "protocol_adapter": {
          "anyOf": [
            {
              "const": "acp-client-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Adapter"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "revision": {
          "default": "0.1.0",
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "secret_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secret Names",
          "type": "array"
        },
        "supported_models": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Supported Models",
          "type": "array"
        },
        "supports_tito": {
          "default": false,
          "title": "Supports Tito",
          "type": "boolean"
        },
        "tito_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tito Path"
        },
        "trajectory_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory Path"
        }
      },
      "required": [
        "name"
      ],
      "title": "HarnessDefinition",
      "type": "object"
    },
    "HarnessPackage": {
      "additionalProperties": false,
      "description": "Content-addressed harness definition and source.",
      "properties": {
        "definition": {
          "$ref": "#/$defs/HarnessDefinition"
        },
        "source": {
          "$ref": "#/$defs/PackageSource"
        }
      },
      "required": [
        "definition",
        "source"
      ],
      "title": "HarnessPackage",
      "type": "object"
    },
    "PackageSource": {
      "additionalProperties": false,
      "description": "Immutable package source.",
      "properties": {
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "local",
            "oci",
            "archive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trusted": {
          "default": false,
          "title": "Trusted",
          "type": "boolean"
        },
        "unsafe_local": {
          "default": false,
          "title": "Unsafe Local",
          "type": "boolean"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "PackageSource",
      "type": "object"
    },
    "RoutingSpec": {
      "additionalProperties": false,
      "description": "Portable model routing configuration.",
      "properties": {
        "fallback_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "title": "RoutingSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Revisioned Agent independent of any Environment.",
  "properties": {
    "auth_mode": {
      "default": "environment",
      "enum": [
        "environment",
        "api_key",
        "oauth",
        "none"
      ],
      "title": "Auth Mode",
      "type": "string"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "harness_package": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessPackage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "revision": {
      "default": "0.1.0",
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "routing": {
      "$ref": "#/$defs/RoutingSpec"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_names": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    }
  },
  "required": [
    "name",
    "model"
  ],
  "title": "AgentDefinition",
  "type": "object"
}
