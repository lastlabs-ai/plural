{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "Hashed artifact reference; large content is never embedded.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "EnvironmentIdentity": {
      "additionalProperties": false,
      "description": "Exact Environment revision identity.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "EnvironmentIdentity",
      "type": "object"
    },
    "HarnessBinding": {
      "additionalProperties": false,
      "description": "Exact harness revision.",
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "name",
        "revision",
        "digest"
      ],
      "title": "HarnessBinding",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessGrant": {
      "additionalProperties": false,
      "description": "Effective harness tool policy for one Trial.\n\nComputed when an Agent binds to a Task Environment. The Environment may\nonly subtract harness tools; it does not own or wrap the model.",
      "properties": {
        "declared": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Declared",
          "type": "array",
          "uniqueItems": true
        },
        "denial_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Denial Reasons",
          "type": "object"
        },
        "denied": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Denied",
          "type": "array",
          "uniqueItems": true
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentIdentity"
        },
        "granted": {
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Granted",
          "type": "array",
          "uniqueItems": true
        },
        "harness": {
          "$ref": "#/$defs/HarnessBinding"
        }
      },
      "required": [
        "environment",
        "harness",
        "declared",
        "granted",
        "denied"
      ],
      "title": "HarnessGrant",
      "type": "object"
    },
    "JobMode": {
      "description": "Execution mode.",
      "enum": [
        "eval",
        "train"
      ],
      "title": "JobMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable TrialExecution provenance.",
  "properties": {
    "agent_digest": {
      "title": "Agent Digest",
      "type": "string"
    },
    "artifact_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Hashes",
      "type": "object"
    },
    "attempt": {
      "default": 1,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "environment_digest": {
      "title": "Environment Digest",
      "type": "string"
    },
    "execution_id": {
      "default": 0,
      "minimum": 0,
      "title": "Execution Id",
      "type": "integer"
    },
    "harness_digest": {
      "default": "",
      "title": "Harness Digest",
      "type": "string"
    },
    "harness_grant": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessGrant"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/JobMode"
    },
    "placement": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Placement",
      "type": "object"
    },
    "retry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "runtime_identity": {
      "default": "",
      "title": "Runtime Identity",
      "type": "string"
    },
    "runtime_provider": {
      "title": "Runtime Provider",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "task_digest": {
      "title": "Task Digest",
      "type": "string"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
    },
    "tito_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "trial_id": {
      "title": "Trial Id",
      "type": "string"
    },
    "trust": {
      "const": "self_reported",
      "default": "self_reported",
      "title": "Trust",
      "type": "string"
    },
    "verifier_digests": {
      "items": {
        "type": "string"
      },
      "title": "Verifier Digests",
      "type": "array"
    }
  },
  "required": [
    "trial_id",
    "job_id",
    "task_digest",
    "environment_digest",
    "verifier_digests",
    "agent_digest",
    "mode",
    "runtime_provider"
  ],
  "title": "TrialReceipt",
  "type": "object"
}
