        "evidence_required": {
          "default": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "kind": {
          "const": "deterministic",
          "default": "deterministic",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "result_path": {
          "default": "verifier-result.json",
          "title": "Result Path",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/VerifierRuntime"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "check"
      ],
      "title": "DeterministicVerifier",
      "type": "object"
    },
    "EnvironmentResource": {
      "additionalProperties": false,
      "description": "Data or application supplied by an Environment.\n\nThe short form ``Resource(\"policies/refunds.md\")`` stages one file from\nthe Environment's source package. The mapping form keeps its explicit\n``delivery``.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "delivery": {
          "default": "descriptor",
          "enum": [
            "descriptor",
            "source",
            "inline",
            "resolver"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "data",
            "application",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EnvironmentResource",
      "type": "object"
    },
    "EvaluationTrack": {
      "additionalProperties": false,
      "description": "Versioned rules that make results on one track comparable.\n\nA ``models`` track holds the setup fixed so results compare models: one\nharness, no extra instructions, and fixed inference settings. An\n``agents`` track compares complete systems, so harness, instructions,\ntools, and settings may differ within the declared limits.\n\nA track version is immutable within a Benchmark. Changing a rule needs a\nnew track version, and results on different versions are not ranked\ntogether.\n\nAttributes:\n    id: Stable track identifier, such as ``\"controlled\"``.\n    version: Semantic version of these rules.\n    name: Label shown to readers.\n    kind: ``\"models\"`` or ``\"agents\"``.\n    description: What the track holds constant, in plain words.\n    attempts: Attempts per Task every ranked result must have.\n    max_retries: Infrastructure retries allowed per attempt.\n    harnesses: Allowed harness names. Empty allows any on an ``agents``\n        track and means the built-in loop on a ``models`` track.\n    instructions: ``\"none\"`` forbids Agent instructions beyond the Task.\n    temperature: Required temperature, when fixed.\n    max_tokens: Required output-token limit, when fixed.\n    tools: How tools are provided, in words; tools come from the Task\n        Environment and the allowed harnesses.\n    max_turns: Highest turn limit an Environment in this release may set.\n    max_seconds: Highest time limit an Environment may set.\n    max_cost_usd: Highest cost limit an Environment may set.",
      "properties": {
        "attempts": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "harnesses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Harnesses",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "instructions": {
          "default": "any",
          "enum": [
            "none",
            "any"
          ],
          "title": "Instructions",
          "type": "string"
        },
        "kind": {
          "enum": [
            "models",
            "agents"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_retries": {
          "default": 0,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Seconds"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_turns": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Turns"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "tools": {
          "default": "Environment actions only.",
          "title": "Tools",
          "type": "string"
        },
        "version": {
          "default": "1.0.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "EvaluationTrack",
      "type": "object"
    },
