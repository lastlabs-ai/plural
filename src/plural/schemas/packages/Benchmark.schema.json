{
  "$defs": {
    "AgentVerifier": {
      "additionalProperties": false,
      "description": "Model-judge verifier with its own runtime and connectivity policy.",
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "fallback_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "runtime": {
          "$ref": "#/$defs/VerifierRuntime"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "criteria",
        "model",
        "instructions"
      ],
      "title": "AgentVerifier",
      "type": "object"
    },
    "BenchmarkCategory": {
      "additionalProperties": false,
      "description": "A named group of Tasks, scored together in results.\n\n``id`` is stable across releases. A category is author-defined unless\n``taxonomy`` names a shared classification, such as ``\"plural:coding\"``.\nScores in author-defined categories are only comparable within this\nBenchmark; two Benchmarks that both say \"reasoning\" may measure different\nthings.\n\nAttributes:\n    id: Stable identifier within the Benchmark, such as ``\"hard-words\"``.\n    name: Label shown to readers.\n    description: What the Tasks in this category have in common.\n    tasks: Names of the Tasks in this category. A Task may be in several.\n    taxonomy: Optional shared classification identifier.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "tasks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        },
        "taxonomy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxonomy"
        }
      },
      "required": [
        "id",
        "name",
        "tasks"
      ],
      "title": "BenchmarkCategory",
      "type": "object"
    },
    "BenchmarkScoring": {
      "additionalProperties": false,
      "description": "How a release turns attempts into one score per configuration.\n\nRepeated attempts of a Task are averaged first. Task scores are then\ncombined with ``task_weights``; a Task without a weight counts once. Step\nrewards never contribute: only the Verifier score on each Trial does.\n\nAttributes:\n    metric: Human-readable name of the success metric, such as\n        ``\"Resolution rate\"``. It labels the Verifier score; it never\n        selects a different value to rank on.\n    description: What a score means, in words a reader can act on.\n    aggregation: How Task scores combine. ``\"weighted_mean\"`` averages\n        attempts per Task, then takes the ``task_weights`` mean.\n    score_range: Lowest and highest possible Task score.\n    success_threshold: A Task attempt at or above this score counts as a\n        success. ``None`` means the Benchmark has no pass/fail notion.\n    task_weights: Weight per Task name. Unlisted Tasks weigh 1.\n    coverage_required: Weighted share of Tasks that must have a score\n        before a result can be ranked officially.\n    agent_failure: How an attempt that ended without a Verifier score\n        because of the Agent (for example, a budget ran out) is scored.\n        ``\"zero\"`` scores it at the bottom of the range.\n    infrastructure_error: Attempts lost to the runtime or provider are\n        excluded from scores and reported separately.\n    min_tasks_for_interval: Fewest scored Tasks before an uncertainty\n        interval is reported. Below this, uncertainty is shown as unknown.",
      "properties": {
        "agent_failure": {
          "default": "zero",
          "enum": [
            "zero",
            "exclude"
          ],
          "title": "Agent Failure",
          "type": "string"
        },
        "aggregation": {
          "const": "weighted_mean",
          "default": "weighted_mean",
          "title": "Aggregation",
          "type": "string"
        },
        "coverage_required": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Coverage Required",
          "type": "number"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "infrastructure_error": {
          "const": "exclude",
          "default": "exclude",
          "title": "Infrastructure Error",
          "type": "string"
        },
        "metric": {
          "default": "Score",
          "title": "Metric",
          "type": "string"
        },
        "min_tasks_for_interval": {
          "default": 5,
          "minimum": 2,
          "title": "Min Tasks For Interval",
          "type": "integer"
        },
        "score_range": {
          "default": [
            0.0,
            1.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Score Range",
          "type": "array"
        },
        "success_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1.0,
          "title": "Success Threshold"
        },
        "task_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Task Weights",
          "type": "object"
        }
      },
      "title": "BenchmarkScoring",
      "type": "object"
    },
    "DeterministicVerifier": {
      "additionalProperties": false,
