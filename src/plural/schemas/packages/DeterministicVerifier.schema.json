{
  "$defs": {
    "EvidenceContract": {
      "additionalProperties": false,
      "description": "What a Verifier needs from the Environment and Trial artifacts.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "include_hidden_state": {
          "default": false,
          "title": "Include Hidden State",
          "type": "boolean"
        },
        "observation_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observation Paths",
          "type": "array"
        },
        "state_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "State Paths",
          "type": "array"
        }
      },
      "title": "EvidenceContract",
      "type": "object"
    },
    "NetworkMode": {
      "description": "Requested sandbox network policy.",
      "enum": [
        "none",
        "restricted",
        "full"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "VerifierRuntime": {
      "additionalProperties": false,
      "description": "Verifier-owned runtime and connectivity, independent of the Environment.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "none"
        },
        "network_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "VerifierRuntime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic command verifier.",
  "properties": {
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceContract"
    },
    "evidence_required": {
      "default": true,
      "title": "Evidence Required",
      "type": "boolean"
    },
    "kind": {
      "const": "deterministic",
      "default": "deterministic",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "result_path": {
      "default": "verifier-result.json",
      "title": "Result Path",
      "type": "string"
    },
    "revision": {
      "default": "0.1.0",
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/VerifierRuntime"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "command"
  ],
  "title": "DeterministicVerifier",
  "type": "object"
}
