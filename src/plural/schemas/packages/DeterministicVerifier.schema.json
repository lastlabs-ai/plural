{
  "$defs": {
    "Every": {
      "additionalProperties": false,
      "description": "A period: every ``sim_time`` clock units, or every ``steps`` steps.",
      "properties": {
        "sim_time": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sim Time"
        },
        "steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        }
      },
      "title": "Every",
      "type": "object"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "description": "One metric a Verifier declares: what it measures and which way is better.\n\n``range`` bounds a ``score`` (by default 0 to 1) or a ``rating`` (required).\nA ``running`` metric is sampled after every step and needs an\n``aggregate`` to become one number per Trial; ``time_to`` also needs a\n``threshold``, and counts the steps until the value first crosses it in the\ngood direction.\n\n``gate: true`` makes the metric one a Trial must pass: a binary gate passes\nat 1, any other gate when it meets its ``target`` (``>= 150``, ``<= 0.5``,\n``== 1``, or ``between 1 5``), which a non-binary gate needs. A ``target``\non a metric that is not a gate is reported, never judged.\n\nA running metric a ``measure`` hook gives per seat has a series per seat,\neach aggregated on its own and judged as a gate on its own; the Trial's\nvalue combines the seats' by ``seat_aggregate`` (by default their mean).\n\nExamples:\n    >>> MetricSpec(name=\"price_correct\", kind=\"binary\").range\n    (0.0, 1.0)\n    >>> MetricSpec(name=\"tone\", kind=\"rating\", range=(1, 5)).direction\n    'higher'",
      "properties": {
        "aggregate": {
          "anyOf": [
            {
              "enum": [
                "final",
                "mean",
                "min",
                "max",
                "auc",
                "time_to"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregate"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "default": "higher",
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "gate": {
          "default": false,
          "title": "Gate",
          "type": "boolean"
        },
        "kind": {
          "default": "score",
          "enum": [
            "binary",
            "score",
            "number",
            "rating",
            "running"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "seat_aggregate": {
          "anyOf": [
            {
              "enum": [
                "mean",
                "sum",
                "min",
                "max"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Aggregate"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "NetworkMode": {
      "description": "Requested sandbox network policy.\n\nUse public, no-network, or allowlist to configure outbound access.",
      "enum": [
        "public",
        "no-network",
        "allowlist",
        "public",
        "no-network",
        "allowlist"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "storage_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Mb"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "description": "One Agent or Human rubric criterion.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_score": {
          "default": 1,
          "title": "Max Score",
          "type": "number"
        },
        "min_score": {
          "default": 0,
          "title": "Min Score",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A named value an App needs, which it never stores itself.\n\nIn an App's ``secrets`` it is a setup secret, such as a sandbox's admin\ntoken, supplied by the project for reset and snapshot hooks and Verifiers.\nIn its ``credentials`` it is supplied by the Agent that runs, such as the\nSalesforce token of the user that Agent acts as. Either way the value\nreaches only the App host, never the Harness or the model.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SecretReference",
      "type": "object"
    },
    "VerifierRuntime": {
      "additionalProperties": false,
      "description": "Machine for a verifier that needs its own sandbox.\n\nThe default runs in the Task Environment. Set a provider, image, network,\nresource limit, or timeout to use a different machine.",
      "properties": {
        "allowed_hosts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "compute": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "public"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "VerifierRuntime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "check"
      ]
    },
    {
      "required": [
        "command"
      ]
    },
    {
      "required": [
        "reward"
      ]
    },
    {
      "required": [
        "hindsight"
      ]
    }
  ],
  "description": "Code that verifies an episode: it scores the end, rewards actions, or both.\n\n``check`` scores the finished episode; that score is what Tasks and\nBenchmarks rank on. It is a function of the :class:`Episode`, a\n``{\"python\": \"verify.py:check\"}`` reference, or a command argv.\n\n``reward`` rewards each action while the episode runs. It is a function of\none :class:`Step`, or a ``{\"python\": \"verify.py:reward\"}`` reference, and\nruns in the Runtime beside the Apps, so it can read every App. What it\nreturns goes to the Trial's reward ledger. Rewards reach the score only\nwhen ``check`` is :func:`total_reward`.\n\n``hindsight`` credits the finished trajectory as a whole: a function of a\n:class:`~plural.rewards.HindsightTrial` that returns\n:class:`~plural.rewards.Credit` values, or a ``{\"python\":\n\"verify.py:efficiency\"}`` reference. It runs after the score, and can also\nrun later on stored Trials with ``plural verifier apply``.",
  "properties": {
    "check": {
      "default": null,
      "title": "Check"
    },
    "criteria": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RubricCriterion"
      },
      "title": "Criteria",
      "type": "array"
    },
    "evidence_required": {
      "default": true,
      "title": "Evidence Required",
      "type": "boolean"
    },
    "hindsight": {
      "default": null,
      "title": "Hindsight"
    },
    "info": {
      "default": null,
      "title": "Info"
    },
    "kind": {
      "const": "deterministic",
      "default": "deterministic",
      "title": "Kind",
      "type": "string"
    },
    "measure": {
      "default": null,
      "title": "Measure"
    },
    "measure_every": {
      "anyOf": [
        {
          "$ref": "#/$defs/Every"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricSpec"
      },
      "title": "Metrics",
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "result_path": {
      "default": "verifier-result.json",
      "title": "Result Path",
      "type": "string"
    },
    "reward": {
      "default": null,
      "title": "Reward"
    },
    "runtime": {
      "$ref": "#/$defs/VerifierRuntime"
    },
    "secrets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SecretReference"
      },
      "title": "Secrets",
      "type": "array"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    },
    "weight": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Weight",
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "title": "DeterministicVerifier",
  "type": "object"
}
