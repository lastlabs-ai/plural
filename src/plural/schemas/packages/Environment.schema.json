{
  "$defs": {
    "AppAction": {
      "additionalProperties": false,
      "description": "One move an App offers the Agent.\n\n``name`` is the App's own name for the action (a Python method name or an\nMCP tool name), which is how the App is called. The Agent sees it under\nits exposed name: the same name, with any character a model provider\nrejects replaced, and prefixed ``<app>__`` only when another App offers\nthe same name.",
      "properties": {
        "binding": {
          "additionalProperties": true,
          "title": "Binding",
          "type": "object"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "mutates_state": {
          "default": true,
          "title": "Mutates State",
          "type": "boolean"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "AppAction",
      "type": "object"
    },
    "AppDefinition": {
      "additionalProperties": false,
      "description": "One App inside an Environment.\n\n``python`` names the App class as ``file.py:Class`` inside the Environment's\nsource package. ``config`` holds the keyword arguments the App was built\nwith, so the App host can rebuild the same App inside a Runtime.",
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AppAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "control": {
          "default": "owned",
          "enum": [
            "owned",
            "sandboxed",
            "live",
            "replayed"
          ],
          "title": "Control",
          "type": "string"
        },
        "credentials": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Credentials",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "has_reset": {
          "default": false,
          "title": "Has Reset",
          "type": "boolean"
        },
        "has_snapshot": {
          "default": false,
          "title": "Has Snapshot",
          "type": "boolean"
        },
        "kind": {
          "default": "python",
          "enum": [
            "python",
            "mcp",
            "openapi",
            "replay"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "python": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Secrets",
          "type": "array"
        },
        "state_schema": {
          "additionalProperties": true,
          "title": "State Schema",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "AppDefinition",
      "type": "object"
    },
    "DeclarativeImage": {
      "additionalProperties": false,
      "description": "Portable subset of Daytona's declarative image builder.",
      "properties": {
        "base": {
          "minLength": 1,
          "title": "Base",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "pip_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pip Packages",
          "type": "array"
        },
        "workdir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workdir"
        }
      },
      "required": [
        "base"
      ],
      "title": "DeclarativeImage",
      "type": "object"
    },
    "EnvironmentResource": {
      "additionalProperties": false,
      "description": "Data or application supplied by an Environment.\n\nThe short form ``Resource(\"policies/refunds.md\")`` stages one file from\nthe Environment's source package. The mapping form keeps its explicit\n``delivery``. ``Resource.from_file(path)`` reads a file of any type: text\ntravels inline, and anything else, such as a PDF or a drawing, as a\n``blob`` named by its digest.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "delivery": {
          "default": "descriptor",
          "enum": [
            "descriptor",
            "source",
            "inline",
            "resolver",
            "blob"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "data",
            "application",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EnvironmentResource",
      "type": "object"
    },
    "EnvironmentRuntime": {
      "additionalProperties": false,
      "description": "Where an Environment runs: Docker, a trusted local process, or a remote sandbox.",
      "properties": {
        "allow_unsafe_local": {
          "default": false,
          "title": "Allow Unsafe Local",
          "type": "boolean"
        },
        "allowed_hosts": {
          "default": [],
          "description": "Hosts the Runtime may reach when network is 'allowlist'.",
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "build_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Context"
        },
        "build_timeout_seconds": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Build Timeout Seconds",
          "type": "number"
        },
        "compose": {
          "default": false,
          "title": "Compose",
          "type": "boolean"
        },
        "compute": {
          "$ref": "#/$defs/ResourceRequirements",
          "description": "CPU, memory, storage, and process limits for the Runtime."
        },
        "declarative_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclarativeImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dockerfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dockerfile"
        },
        "extra_capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SandboxCapability"
          },
          "title": "Extra Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "public"
        },
        "packages": {
          "$ref": "#/$defs/RuntimePackages",
          "description": "Packages installed in the Runtime before an episode. In environment.yaml, list Python ones under python_packages. On the local Runtime they must already be installed."
        },
        "persistent": {
          "default": false,
          "title": "Persistent",
          "type": "boolean"
        },
        "placement": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Placement",
          "type": "object"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "read_only_root": {
          "default": false,
          "title": "Read Only Root",
          "type": "boolean"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slug of the project Runtime this configuration was copied from. The machine fields hold that Runtime's settings as of the copy; credentials come from the project Runtime when a Job starts.",
          "title": "Ref"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ExecutionTarget"
          },
          "title": "Targets",
          "type": "array",
          "uniqueItems": true
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "variables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeVariable"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "title": "EnvironmentRuntime",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "description": "Environment execution limits.",
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Max Seconds",
          "type": "number"
        },
        "max_turns": {
          "default": 8,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        }
      },
      "title": "ExecutionLimits",
      "type": "object"
    },
    "ExecutionTarget": {
      "description": "Execution isolation class.",
      "enum": [
        "local",
        "docker",
        "remote"
      ],
      "title": "ExecutionTarget",
      "type": "string"
    },
    "Guardrail": {
      "additionalProperties": false,
      "description": "A plain-language Environment rule.",
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "Guardrail",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessPolicy": {
      "additionalProperties": false,
      "description": "Environment ceiling for a Trial's optional Agent harness.",
      "properties": {
        "allowed_capabilities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HarnessCapability"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Capabilities"
        },
        "allowed_harnesses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Harnesses",
          "type": "array"
        },
        "denied_capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Denied Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "default": "allow_all",
          "enum": [
            "allow_all",
            "allowlist"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "HarnessPolicy",
      "type": "object"
    },
    "NetworkMode": {
      "description": "Requested sandbox network policy.\n\nUse public, no-network, or allowlist to configure outbound access.",
      "enum": [
        "public",
        "no-network",
        "allowlist",
        "public",
        "no-network",
        "allowlist"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "Party": {
      "additionalProperties": false,
      "description": "How many Agents may share one episode of the Environment, such as 2 to 8 at poker.\n\nAn Environment with a party is played by several Agents at once, each in a\nseat of its own: ``seat_1`` to ``seat_N`` for a party of N. A Job names the\nAgents in the party, and its size must fall between ``min`` and ``max``.",
      "properties": {
        "isolation": {
          "default": "isolated",
          "description": "``isolated``: each seat's Harness runs as its own OS user, and the Apps are the only thing the seats share; needs Docker or Daytona. ``shared``: every seat runs as one user and can read and write the others' files and the Environment's, for a team that works on the same files, or to try a party on the local Runtime. A shared seat could also act for another seat.",
          "enum": [
            "isolated",
            "shared"
          ],
          "title": "Isolation",
          "type": "string"
        },
        "max": {
          "default": 2,
          "maximum": 100,
          "minimum": 2,
          "title": "Max",
          "type": "integer"
        },
        "min": {
          "default": 2,
          "maximum": 100,
          "minimum": 2,
          "title": "Min",
          "type": "integer"
        }
      },
      "title": "Party",
      "type": "object"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "storage_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Mb"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "RuntimePackages": {
      "additionalProperties": false,
      "description": "Packages installed in the Runtime before an episode, by package manager.\n\nEach list holds what you would pass to that manager, one package per entry.",
      "properties": {
        "python": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Python",
          "type": "array"
        }
      },
      "title": "RuntimePackages",
      "type": "object"
    },
    "RuntimeVariable": {
      "additionalProperties": false,
      "description": "A launch-time variable declaration. Values are supplied to Job, never saved here.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "format": {
          "default": "text",
          "enum": [
            "text",
            "url",
            "integer",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "RuntimeVariable",
      "type": "object"
    },
    "SandboxCapability": {
      "description": "Individual controls a provider can enforce.",
      "enum": [
        "image",
        "build",
        "resources",
        "network_none",
        "network_allowlist",
        "upload",
        "download",
        "timeout",
        "cancel",
        "persistence",
        "compose",
        "read_only_root",
        "working_directory",
        "environment",
        "log_capture"
      ],
      "title": "SandboxCapability",
      "type": "string"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A named value an App needs, which it never stores itself.\n\nIn an App's ``secrets`` it is a setup secret, such as a sandbox's admin\ntoken, supplied by the project for reset and snapshot hooks and Verifiers.\nIn its ``credentials`` it is supplied by the Agent that runs, such as the\nSalesforce token of the user that Agent acts as. Either way the value\nreaches only the App host, never the Harness or the model.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "SecretReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-v2 Environment: Apps composed with one Runtime and one set of limits.\n\nTasks, Verifiers, and mode are intentionally absent. Every action belongs\nto exactly one App; ``python`` optionally names an Environment subclass\nwhose ``on_step``, ``terminated``, or ``truncated`` span several Apps.",
  "properties": {
    "apps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AppDefinition"
      },
      "title": "Apps",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "guardrails": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Guardrail"
      },
      "title": "Guardrails",
      "type": "array"
    },
    "harness_policy": {
      "$ref": "#/$defs/HarnessPolicy"
    },
    "limits": {
      "$ref": "#/$defs/ExecutionLimits"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "overview": {
      "default": "",
      "title": "Overview",
      "type": "string"
    },
    "party": {
      "anyOf": [
        {
          "$ref": "#/$defs/Party"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How many Agents share each episode, for a game such as poker. Leave it unset for an Environment one Agent works in alone."
    },
    "python": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Python"
    },
    "readme": {
      "default": "",
      "title": "Readme",
      "type": "string"
    },
    "resources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnvironmentResource"
      },
      "title": "Resources",
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/EnvironmentRuntime"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "Environment",
  "type": "object"
}
