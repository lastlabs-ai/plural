{
  "$defs": {
    "Capability": {
      "description": "Individual controls a provider can enforce.",
      "enum": [
        "image",
        "build",
        "resources",
        "network_none",
        "network_allowlist",
        "upload",
        "download",
        "timeout",
        "cancel",
        "persistence",
        "compose",
        "read_only_root",
        "working_directory",
        "environment",
        "log_capture"
      ],
      "title": "Capability",
      "type": "string"
    },
    "DeclarativeImage": {
      "additionalProperties": false,
      "description": "Portable subset of Daytona's declarative image builder.",
      "properties": {
        "base": {
          "minLength": 1,
          "title": "Base",
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "pip_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pip Packages",
          "type": "array"
        },
        "workdir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workdir"
        }
      },
      "required": [
        "base"
      ],
      "title": "DeclarativeImage",
      "type": "object"
    },
    "EnvironmentResource": {
      "additionalProperties": false,
      "description": "Data or application supplied by an Environment.\n\nThe short form ``Resource(\"policies/refunds.md\")`` stages one file from\nthe Environment's source package. The mapping form keeps its explicit\n``delivery``.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "delivery": {
          "default": "descriptor",
          "enum": [
            "descriptor",
            "source",
            "inline",
            "resolver"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "data",
            "application",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EnvironmentResource",
      "type": "object"
    },
    "EnvironmentRuntime": {
      "additionalProperties": false,
      "description": "Where an Environment runs: Docker, a trusted local process, or Daytona.",
      "properties": {
        "allow_unsafe_local": {
          "default": false,
          "title": "Allow Unsafe Local",
          "type": "boolean"
        },
        "build_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Context"
        },
        "build_timeout_sec": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Build Timeout Sec",
          "type": "number"
        },
        "compose": {
          "default": false,
          "title": "Compose",
          "type": "boolean"
        },
        "declarative_image": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeclarativeImage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dockerfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dockerfile"
        },
        "extra_capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Extra Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "public"
        },
        "network_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "persistent": {
          "default": false,
          "title": "Persistent",
          "type": "boolean"
        },
        "placement": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Placement",
          "type": "object"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "read_only_root": {
          "default": false,
          "title": "Read Only Root",
          "type": "boolean"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ExecutionTarget"
          },
          "title": "Targets",
          "type": "array",
          "uniqueItems": true
        },
        "timeout_seconds": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "variables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuntimeVariable"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "title": "EnvironmentRuntime",
      "type": "object"
    },
    "ExecutionLimits": {
      "additionalProperties": false,
      "description": "Environment execution limits.",
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Max Seconds",
          "type": "number"
        },
        "max_turns": {
          "default": 8,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        }
      },
      "title": "ExecutionLimits",
      "type": "object"
    },
    "ExecutionTarget": {
      "description": "Execution isolation class.",
      "enum": [
        "local",
        "docker",
        "remote"
      ],
      "title": "ExecutionTarget",
      "type": "string"
    },
    "Guardrail": {
      "additionalProperties": false,
      "description": "A plain-language Environment rule.",
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "rule": {
          "minLength": 1,
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "Guardrail",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessPolicy": {
      "additionalProperties": false,
      "description": "Environment ceiling for a Trial's optional Agent harness.",
      "properties": {
        "allowed_capabilities": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HarnessCapability"
              },
              "type": "array",
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Capabilities"
        },
        "allowed_harnesses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Harnesses",
          "type": "array"
        },
        "denied_capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Denied Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "mode": {
          "default": "allow_all",
          "enum": [
            "allow_all",
            "allowlist"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "HarnessPolicy",
      "type": "object"
    },
    "NativeAction": {
      "additionalProperties": false,
      "description": "An action owned by an Environment.",
      "properties": {
        "command": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "default": "command",
          "enum": [
            "command",
            "python"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mutates_state": {
          "default": true,
          "title": "Mutates State",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "observation_schema": {
          "additionalProperties": true,
          "title": "Observation Schema",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "NativeAction",
      "type": "object"
    },
    "NetworkMode": {
      "description": "Requested sandbox network policy.\n\nUse public, no-network, or allowlist to configure outbound access.",
      "enum": [
        "public",
        "no-network",
        "allowlist",
        "public",
        "no-network",
        "allowlist"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "storage_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Mb"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "RewarderDefinition": {
      "additionalProperties": false,
      "description": "A train-only state-transition rewarder.",
      "properties": {
        "command": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "implementation_digest": {
          "default": "",
          "title": "Implementation Digest",
          "type": "string"
        },
        "kind": {
          "default": "command",
          "enum": [
            "command",
            "python"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "RewarderDefinition",
      "type": "object"
    },
    "RuntimeVariable": {
      "additionalProperties": false,
      "description": "A launch-time variable declaration. Values are supplied to Job, never saved here.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "format": {
          "default": "text",
          "enum": [
            "text",
            "url",
            "integer",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "RuntimeVariable",
      "type": "object"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A named credential supplied when a Job runs, with an explicit execution target.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "target": {
          "default": "environment",
          "enum": [
            "environment",
            "harness",
            "verifier"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "SecretReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-v2 Environment. Tasks, Verifiers, and mode are intentionally absent.",
  "properties": {
    "actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NativeAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "guardrails": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Guardrail"
      },
      "title": "Guardrails",
      "type": "array"
    },
    "harness_policy": {
      "$ref": "#/$defs/HarnessPolicy"
    },
    "limits": {
      "$ref": "#/$defs/ExecutionLimits"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "observation_schema": {
      "additionalProperties": true,
      "title": "Observation Schema",
      "type": "object"
    },
    "overview": {
      "default": "",
      "title": "Overview",
      "type": "string"
    },
    "readme": {
      "default": "",
      "title": "Readme",
      "type": "string"
    },
    "reset_command": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Reset Command",
      "type": "array"
    },
    "resources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnvironmentResource"
      },
      "title": "Resources",
      "type": "array"
    },
    "rewarders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RewarderDefinition"
      },
      "title": "Rewarders",
      "type": "array"
    },
    "runtime": {
      "$ref": "#/$defs/EnvironmentRuntime"
    },
    "secrets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SecretReference"
      },
      "title": "Secrets",
      "type": "array"
    },
    "state_schema": {
      "additionalProperties": true,
      "title": "State Schema",
      "type": "object"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "Environment",
  "type": "object"
}
