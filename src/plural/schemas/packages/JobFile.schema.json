{
  "$defs": {
    "JobMode": {
      "description": "Execution mode.",
      "enum": [
        "eval",
        "train"
      ],
      "title": "JobMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Path-based Job selecting a Benchmark or Task.",
  "properties": {
    "agents": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "minItems": 1,
      "title": "Agents",
      "type": "array"
    },
    "attempts": {
      "default": 1,
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "concurrency": {
      "default": 1,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/JobMode",
      "default": "eval"
    },
    "per_runtime_concurrency": {
      "default": 1,
      "minimum": 1,
      "title": "Per Runtime Concurrency",
      "type": "integer"
    },
    "priority": {
      "default": 0,
      "title": "Priority",
      "type": "integer"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "format": "path",
      "title": "Source",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "benchmark",
        "task"
      ],
      "title": "Source Kind",
      "type": "string"
    }
  },
  "required": [
    "source_kind",
    "source",
    "agents"
  ],
  "title": "JobFile",
  "type": "object"
}
