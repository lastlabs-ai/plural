{
  "$defs": {
    "FileDeclaration": {
      "additionalProperties": false,
      "description": "A file emitted or consumed by a package.",
      "properties": {
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileDeclaration",
      "type": "object"
    },
    "Harness": {
      "additionalProperties": false,
      "description": "Base class for an Agent interaction loop.\n\nSubclasses implement :meth:`run`. Plural discovers and hashes the Python\nclass directory, invokes ``run`` in the Environment Runtime, and emits the\nstandard result, trajectory, and log artifacts.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "title": "Harness",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessDefinition": {
      "additionalProperties": false,
      "description": "A declared executable Agent interaction strategy.\n\nPoint ``source`` at a local directory or a remote archive and name the\n``command`` that runs the loop. Subclass :class:`Harness` instead to write\none in Python.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "auth": {
          "default": [
            "environment"
          ],
          "items": {
            "enum": [
              "environment",
              "api_key",
              "oauth",
              "none"
            ],
            "type": "string"
          },
          "title": "Auth",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "environment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Environment",
          "type": "array"
        },
        "healthcheck": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck"
        },
        "models": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Outputs",
          "type": "array"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "source": {
          "default": ".",
          "title": "Source",
          "type": "string"
        },
        "tito": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tito"
        },
        "trajectory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "HarnessDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A catalog-backed model and its optional execution harness.",
  "properties": {
    "auth_mode": {
      "default": "environment",
      "enum": [
        "environment",
        "api_key",
        "oauth",
        "none"
      ],
      "title": "Auth Mode",
      "type": "string"
    },
    "fallback_models": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Models",
      "type": "array"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessDefinition"
        },
        {
          "$ref": "#/$defs/Harness"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness"
    },
    "harness_kwargs": {
      "additionalProperties": true,
      "title": "Harness Kwargs",
      "type": "object"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "max_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "secret_names": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "model"
  ],
  "title": "Agent",
  "type": "object"
}
