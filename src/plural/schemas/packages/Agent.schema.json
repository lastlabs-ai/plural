{
  "$defs": {
    "AgentCredential": {
      "additionalProperties": false,
      "description": "A credential this Agent supplies to the Apps it works with.\n\nThe value, such as the Salesforce token of the user this Agent acts as, is\nnever part of the Agent: each person who runs it saves their own with\n``plural credential set`` or exports it, and it reaches only the App host.\n``scopes`` records what the token may do, as you describe it; the system\nthat issued the token enforces them, and every Trial records them for audit.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "title": "AgentCredential",
      "type": "object"
    },
    "ExternalAgent": {
      "additionalProperties": false,
      "description": "An agent that already runs as a service of its own.\n\nA Job calls ``url`` with a signed request for each episode. The agent acts\nonly through that episode's actions and files, and its code is not part of\nany content hash: ``version`` is the label you give each release.",
      "properties": {
        "ca_bundle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca Bundle"
        },
        "signing_key": {
          "title": "Signing Key",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "url",
        "signing_key"
      ],
      "title": "ExternalAgent",
      "type": "object"
    },
    "FileDeclaration": {
      "additionalProperties": false,
      "description": "A file emitted or consumed by a package.",
      "properties": {
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "title": "FileDeclaration",
      "type": "object"
    },
    "Harness": {
      "additionalProperties": false,
      "description": "Base class for an Agent interaction loop.\n\nSubclasses implement :meth:`run`. Plural discovers and hashes the Python\nclass directory, invokes ``run`` in the Environment Runtime, and emits the\nstandard result, trajectory, and log artifacts.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "title": "Harness",
      "type": "object"
    },
    "HarnessCapability": {
      "description": "A capability requested by an agent harness.",
      "enum": [
        "shell",
        "file_read",
        "file_edit",
        "code_execution",
        "web_search",
        "browser",
        "network_fetch",
        "mcp",
        "subagents",
        "persistence"
      ],
      "title": "HarnessCapability",
      "type": "string"
    },
    "HarnessDefinition": {
      "additionalProperties": false,
      "description": "A declared executable Agent interaction strategy.\n\nPoint ``source`` at a local directory or a remote archive and name the\n``command`` that runs the loop. Subclass :class:`Harness` instead to write\none in Python.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "auth": {
          "default": [
            "environment"
          ],
          "items": {
            "enum": [
              "environment",
              "api_key",
              "oauth",
              "none"
            ],
            "type": "string"
          },
          "title": "Auth",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HarnessCapability"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "env_vars": {
          "default": [],
          "description": "Names of environment variables passed through to the Harness process.",
          "items": {
            "type": "string"
          },
          "title": "Env Vars",
          "type": "array"
        },
        "healthcheck": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Healthcheck"
        },
        "models": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileDeclaration"
          },
          "title": "Outputs",
          "type": "array"
        },
        "readme": {
          "default": "",
          "description": "Markdown overview shown on the Harness page.",
          "title": "Readme",
          "type": "string"
        },
        "requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "secrets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "source": {
          "default": ".",
          "title": "Source",
          "type": "string"
        },
        "tito": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tito"
        },
        "trajectory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trajectory"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "title": "HarnessDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A catalog-backed model and its optional execution harness.\n\nTo evaluate your own agent or model server instead, give ``endpoint``: the\nbase URL of an OpenAI-compatible API (one that serves\n``/chat/completions``). ``model`` is then sent to it as is and need not be\nin the catalog, and ``endpoint_key`` names the secret holding its API key.\nPlural's native Harness calls it with the Environment's actions as tools,\nand a custom Harness reaches it through ``agent.complete``.\n\nAn agent that already runs elsewhere is an ``external`` Agent instead: the\nJob calls it over signed HTTPS, and ``model`` is the label it reports.\n\n``title`` is only the display name in the hosted project; Jobs and results\ncall the Agent by ``name``.",
  "properties": {
    "auth": {
      "default": "environment",
      "description": "How the Harness authenticates to the model; none when it calls no model.",
      "enum": [
        "environment",
        "api_key",
        "oauth",
        "none"
      ],
      "title": "Auth",
      "type": "string"
    },
    "credentials": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentCredential"
      },
      "title": "Credentials",
      "type": "object"
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    },
    "endpoint_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint Key"
    },
    "external": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExternalAgent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fallback_models": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Models",
      "type": "array"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessDefinition"
        },
        {
          "$ref": "#/$defs/Harness"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness"
    },
    "harness_config": {
      "additionalProperties": true,
      "description": "Options for the Agent's Harness. A built-in Harness validates them; a custom one reads them in self.config, over its own config.",
      "title": "Harness Config",
      "type": "object"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "max_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "secrets": {
      "default": [],
      "description": "Names of the Harness's declared secrets this Agent grants it.",
      "items": {
        "type": "string"
      },
      "title": "Secrets",
      "type": "array"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Display name in the hosted project. Defaults to name.",
      "title": "Title"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "model"
  ],
  "title": "Agent",
  "type": "object"
}
