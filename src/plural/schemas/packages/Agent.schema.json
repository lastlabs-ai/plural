{
  "$defs": {
    "Harness": {
      "additionalProperties": false,
      "description": "Base class for an Agent interaction loop.\n\nSubclasses implement :meth:`run`. Plural discovers and hashes the Python\nclass directory, invokes ``run`` in the Environment Runtime, and emits the\nstandard result, trajectory, and log artifacts.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "title": "Harness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A catalog-backed model and its optional execution harness.",
  "properties": {
    "auth_mode": {
      "default": "environment",
      "enum": [
        "environment",
        "api_key",
        "oauth",
        "none"
      ],
      "title": "Auth Mode",
      "type": "string"
    },
    "fallback_models": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Models",
      "type": "array"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Harness"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness"
    },
    "harness_kwargs": {
      "additionalProperties": true,
      "title": "Harness Kwargs",
      "type": "object"
    },
    "instructions": {
      "default": "",
      "title": "Instructions",
      "type": "string"
    },
    "max_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "default": "",
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "secret_names": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Secret Names",
      "type": "array"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "model"
  ],
  "title": "Agent",
  "type": "object"
}
