        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EnvironmentResource",
      "type": "object"
    },
