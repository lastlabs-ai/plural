{
  "$defs": {
    "AgentVerifier": {
      "additionalProperties": false,
      "description": "Model-judge verifier with its own runtime and connectivity policy.",
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "fallback_models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallback Models",
          "type": "array"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "instructions": {
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "default": "agent",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "runtime": {
          "$ref": "#/$defs/VerifierRuntime"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Secrets",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "criteria",
        "model",
        "instructions"
      ],
      "title": "AgentVerifier",
      "type": "object"
    },
    "DeterministicVerifier": {
      "additionalProperties": false,
      "description": "Code that verifies an episode: it scores the end, rewards actions, or both.\n\n``check`` scores the finished episode; that score is what Tasks and\nBenchmarks rank on. It is a function of the :class:`Episode`, a\n``{\"python\": \"verify.py:check\"}`` reference, or a command argv.\n\n``reward`` rewards each action while the episode runs. It is a function of\none :class:`Step`, or a ``{\"python\": \"verify.py:reward\"}`` reference, and\nruns in the Runtime beside the Apps, so it can read every App. What it\nreturns goes to the Trial's reward ledger. Rewards reach the score only\nwhen ``check`` is :func:`total_reward`.\n\n``hindsight`` credits the finished trajectory as a whole: a function of a\n:class:`~plural.rewards.HindsightTrial` that returns\n:class:`~plural.rewards.Credit` values, or a ``{\"python\":\n\"verify.py:efficiency\"}`` reference. It runs after the score, and can also\nrun later on stored Trials with ``plural verifier apply``.",
      "properties": {
        "check": {
          "default": null,
          "title": "Check"
        },
        "criteria": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "evidence_required": {
          "default": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "hindsight": {
          "default": null,
          "title": "Hindsight"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "kind": {
          "const": "deterministic",
          "default": "deterministic",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "result_path": {
          "default": "verifier-result.json",
          "title": "Result Path",
          "type": "string"
        },
        "reward": {
          "default": null,
          "title": "Reward"
        },
        "runtime": {
          "$ref": "#/$defs/VerifierRuntime"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Secrets",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "DeterministicVerifier",
      "type": "object"
    },
    "EnvironmentResource": {
      "additionalProperties": false,
      "description": "Data or application supplied by an Environment.\n\nThe short form ``Resource(\"policies/refunds.md\")`` stages one file from\nthe Environment's source package. The mapping form keeps its explicit\n``delivery``.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "content_type": {
          "default": "",
          "title": "Content Type",
          "type": "string"
        },
        "delivery": {
          "default": "descriptor",
          "enum": [
            "descriptor",
            "source",
            "inline",
            "resolver"
          ],
          "title": "Delivery",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "kind": {
          "enum": [
            "data",
            "application",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "resolver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "EnvironmentResource",
      "type": "object"
    },
    "HumanVerifier": {
      "additionalProperties": false,
      "description": "Human review verifier.",
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "instructions": {
          "default": "",
          "title": "Instructions",
          "type": "string"
        },
        "kind": {
          "const": "human",
          "default": "human",
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Secrets",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "criteria"
      ],
      "title": "HumanVerifier",
      "type": "object"
    },
    "NetworkMode": {
      "description": "Requested sandbox network policy.\n\nUse public, no-network, or allowlist to configure outbound access.",
      "enum": [
        "public",
        "no-network",
        "allowlist",
        "public",
        "no-network",
        "allowlist"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "storage_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Mb"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "description": "One Agent or Human rubric criterion.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_score": {
          "default": 1,
          "title": "Max Score",
          "type": "number"
        },
        "min_score": {
          "default": 0,
          "title": "Min Score",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "A named value an App needs, which it never stores itself.\n\nIn an App's ``secrets`` it is a setup secret, such as a sandbox's admin\ntoken, supplied by the project for reset and snapshot hooks and Verifiers.\nIn its ``credentials`` it is supplied by the Agent that runs, such as the\nSalesforce token of the user that Agent acts as. Either way the value\nreaches only the App host, never the Harness or the model.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "SecretReference",
      "type": "object"
    },
    "VerifierRuntime": {
      "additionalProperties": false,
      "description": "Machine for a verifier that needs its own sandbox.\n\nThe default runs in the Task Environment. Set a provider, image, network,\nresource limit, or timeout to use a different machine.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "public"
        },
        "network_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "VerifierRuntime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One versioned unit of work in a Python-authored Environment.",
  "properties": {
    "environment": {
      "title": "Environment"
    },
    "goals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Goals",
      "type": "array"
    },
    "info": {
      "default": null,
      "title": "Info"
    },
    "initial_state": {
      "additionalProperties": true,
      "title": "Initial State",
      "type": "object"
    },
    "instructions": {
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "reset_options": {
      "additionalProperties": true,
      "title": "Reset Options",
      "type": "object"
    },
    "resources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnvironmentResource"
      },
      "title": "Resources",
      "type": "array"
    },
    "verifiers": {
      "items": {
        "discriminator": {
          "mapping": {
            "agent": "#/$defs/AgentVerifier",
            "deterministic": "#/$defs/DeterministicVerifier",
            "human": "#/$defs/HumanVerifier"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DeterministicVerifier"
          },
          {
            "$ref": "#/$defs/AgentVerifier"
          },
          {
            "$ref": "#/$defs/HumanVerifier"
          }
        ]
      },
      "minItems": 1,
      "title": "Verifiers",
      "type": "array"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "instructions",
    "environment",
    "verifiers"
  ],
  "title": "Task",
  "type": "object"
}
