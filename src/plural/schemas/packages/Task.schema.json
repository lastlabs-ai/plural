    "DeterministicVerifier": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "check"
          ]
        },
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "reward"
          ]
        },
        {
          "required": [
            "hindsight"
          ]
        }
      ],
      "description": "Code that verifies an episode: it scores the end, rewards actions, or both.\n\n``check`` scores the finished episode; that score is what Tasks and\nBenchmarks rank on. It is a function of the :class:`Episode`, a\n``{\"python\": \"verify.py:check\"}`` reference, or a command argv.\n\n``reward`` rewards each action while the episode runs. It is a function of\none :class:`Step`, or a ``{\"python\": \"verify.py:reward\"}`` reference, and\nruns in the Runtime beside the Apps, so it can read every App. What it\nreturns goes to the Trial's reward ledger. Rewards reach the score only\nwhen ``check`` is :func:`total_reward`.\n\n``hindsight`` credits the finished trajectory as a whole: a function of a\n:class:`~plural.rewards.HindsightTrial` that returns\n:class:`~plural.rewards.Credit` values, or a ``{\"python\":\n\"verify.py:efficiency\"}`` reference. It runs after the score, and can also\nrun later on stored Trials with ``plural verifier apply``.",
      "properties": {
        "check": {
          "default": null,
          "title": "Check"
        },
        "criteria": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RubricCriterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "evidence_required": {
          "default": true,
          "title": "Evidence Required",
          "type": "boolean"
        },
        "hindsight": {
          "default": null,
          "title": "Hindsight"
        },
        "info": {
          "default": null,
          "title": "Info"
        },
        "kind": {
          "const": "deterministic",
          "default": "deterministic",
          "title": "Kind",
          "type": "string"
        },
        "measure": {
          "default": null,
          "title": "Measure"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metrics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MetricSpec"
          },
          "title": "Metrics",
          "type": "array"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "result_path": {
          "default": "verifier-result.json",
          "title": "Result Path",
          "type": "string"
        },
        "reward": {
          "default": null,
          "title": "Reward"
        },
        "runtime": {
          "$ref": "#/$defs/VerifierRuntime"
        },
        "secrets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SecretReference"
          },
          "title": "Secrets",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "title": "DeterministicVerifier",
      "type": "object"
    },
    "EnvironmentResource": {
      "additionalProperties": false,
      "description": "Data or application supplied by an Environment.\n\nThe short form ``Resource(\"policies/refunds.md\")`` stages one file from\nthe Environment's source package. The mapping form keeps its explicit\n``delivery``. ``Resource.from_file(path)`` reads a file of any type: text\ntravels inline, and anything else, such as a PDF or a drawing, as a\n``blob`` named by its digest.",
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content": {
          "anyOf": [
            {
              "maxLength": 1048576,
              "type": "string"
            },
            {
              "type": "null"
