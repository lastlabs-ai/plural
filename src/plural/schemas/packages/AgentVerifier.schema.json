{
  "$defs": {
    "NetworkMode": {
      "description": "Requested sandbox network policy.\n\nUse public, no-network, or allowlist to configure outbound access.",
      "enum": [
        "public",
        "no-network",
        "allowlist",
        "public",
        "no-network",
        "allowlist"
      ],
      "title": "NetworkMode",
      "type": "string"
    },
    "ResourceRequirements": {
      "additionalProperties": false,
      "description": "Optional compute limits.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "disk_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disk Mb"
        },
        "memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Mb"
        },
        "pids": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        },
        "storage_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Mb"
        }
      },
      "title": "ResourceRequirements",
      "type": "object"
    },
    "RubricCriterion": {
      "additionalProperties": false,
      "description": "One Agent or Human rubric criterion.",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "max_score": {
          "default": 1,
          "title": "Max Score",
          "type": "number"
        },
        "min_score": {
          "default": 0,
          "title": "Min Score",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "RubricCriterion",
      "type": "object"
    },
    "VerifierRuntime": {
      "additionalProperties": false,
      "description": "Verifier-owned runtime, independent of the Environment.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "network": {
          "$ref": "#/$defs/NetworkMode",
          "default": "public"
        },
        "network_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Network Allowlist",
          "type": "array"
        },
        "provider": {
          "default": "docker",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "resources": {
          "$ref": "#/$defs/ResourceRequirements"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "title": "VerifierRuntime",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Model-judge verifier with its own runtime and connectivity policy.",
  "properties": {
    "criteria": {
      "items": {
        "$ref": "#/$defs/RubricCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "fallback_models": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fallback Models",
      "type": "array"
    },
    "info": {
      "default": null,
      "title": "Info"
    },
    "instructions": {
      "minLength": 1,
      "title": "Instructions",
      "type": "string"
    },
    "kind": {
      "const": "agent",
      "default": "agent",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "runtime": {
      "$ref": "#/$defs/VerifierRuntime"
    },
    "version": {
      "default": "0.1.0",
      "title": "Version",
      "type": "string"
    },
    "weight": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Weight",
      "type": "number"
    }
  },
  "required": [
    "name",
    "criteria",
    "model",
    "instructions"
  ],
  "title": "AgentVerifier",
  "type": "object"
}
