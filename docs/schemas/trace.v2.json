      ],
      "title": "ReasoningBlock",
      "type": "object"
    },
    "ResponseFormat": {
      "description": "Structured output / response format request.\n\nAttributes:\n    type: Format type such as ``\"text\"``, ``\"json_object\"``, or ``\"json_schema\"``.\n    json_schema: Schema payload when ``type`` is ``\"json_schema\"``.",
      "properties": {
        "json_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Schema"
        },
        "type": {
          "default": "text",
          "enum": [
            "text",
            "json_object",
            "json_schema"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ResponseFormat",
      "type": "object"
    },
    "RewardEvent": {
      "description": "A dense reward attached to one turn.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "RewardEvent",
      "type": "object"
    },
    "Role": {
      "description": "Chat message role.",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ],
      "title": "Role",
      "type": "string"
    },
    "TextContent": {
      "description": "A text content part.\n\nAttributes:\n    type: Discriminator; always ``\"text\"``.\n    text: The text content.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextContent",
      "type": "object"
    },
    "Tool": {
      "description": "A tool the model may call.\n\nAttributes:\n    type: Tool type; currently only ``\"function\"``.\n    function: The function definition.\n\nExamples:\n    >>> tool = Tool(\n    ...     function=FunctionDefinition(\n    ...         name=\"lookup_order\",\n    ...         description=\"Look up an order by id\",\n    ...         parameters={\n    ...             \"type\": \"object\",\n    ...             \"properties\": {\"order_id\": {\"type\": \"string\"}},\n    ...             \"required\": [\"order_id\"],\n    ...         },\n    ...     )\n    ... )\n    >>> tool.function.name\n    'lookup_order'",
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionDefinition"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "function"
      ],
      "title": "Tool",
      "type": "object"
    },
    "ToolCall": {
      "description": "A tool call in an assistant message.\n\nAttributes:\n    id: Provider-assigned call id used to correlate tool responses.\n    type: Tool type; currently only ``\"function\"``.\n    function: The function call payload.",
      "properties": {
        "function": {
          "$ref": "#/$defs/FunctionCall"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "function",
          "default": "function",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "function"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "Turn": {
      "description": "One model turn inside an episode: observation \u2192 action \u2192 observation.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionStep"
          },
          "title": "Actions",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "model_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatRequest"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Context"
        },
        "model_output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatResponse"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Output"
        },
        "observation": {
          "default": null,
          "title": "Observation"
        },
        "parsed_action": {
          "items": {
            "$ref": "#/$defs/ParsedAction"
          },
          "title": "Parsed Action",
          "type": "array"
        },
        "reasoning": {
          "items": {
            "$ref": "#/$defs/ReasoningBlock"
          },
          "title": "Reasoning",
          "type": "array"
        },
        "reward_events": {
          "items": {
            "$ref": "#/$defs/RewardEvent"
          },
          "title": "Reward Events",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "turn": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "turn",
          "default": "turn",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Turn",
      "type": "object"
    },
    "Usage": {
      "description": "Token usage for a completion.\n\nAttributes:\n    prompt_tokens: Input token count.\n    completion_tokens: Output token count.\n    total_tokens: Sum of prompt and completion tokens.\n    cost: Estimated USD cost when known.",
      "properties": {
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "https://pluralintel.com/schemas/trace.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A complete record of an LLM interaction or environment rollout.\n\nProduction traffic and environment rollouts emit the same shape so that\ndatasets, benchmarks, and a future autorouter can consume either source.\n\nAttributes:\n    trace_id: Opaque unique id.\n    environment: Environment name when produced by a rollout.\n    environment_version: Environment version string.\n    environment_fingerprint: Hash of tools, instructions, and scorers.\n    task_id: Task id within an environment.\n    model: Policy / model id used for this episode.\n    initial_state: Environment snapshot at reset.\n    steps: Ordered steps (decisions, LLM calls, tool calls, events).\n    final_state: Environment snapshot at episode close.\n    outcome: Optional labeled outcome. ``outcome.reward`` is the return.\n    metrics: Episode aggregates (turns, cost, latency, tool counts).\n    terminated: Natural end (``env.done()``).\n    truncated: Cut off by ``max_turns``.\n    tags: Free-form tags for filtering.\n    metadata: Arbitrary metadata.\n    created_at: Creation timestamp (UTC).\n    schema_version: Trace schema version for stability.\n\nExamples:\n    >>> t = Trace(trace_id=\"t1\", tags={\"env\": \"prod\"})\n    >>> t.schema_version\n    '2.0.0'",
  "properties": {
    "agent_instance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Instance Id"
    },
    "agent_template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Template Id"
    },
    "capability_denials": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CapabilityDenial"
      },
      "title": "Capability Denials",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "denied_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Denied Capabilities",
      "type": "array"
    },
    "environment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Fingerprint"
    },
    "environment_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Version"
    },
    "episode_trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Trace Id"
    },
    "failed": {
      "default": false,
      "title": "Failed",
      "type": "boolean"
    },
    "final_state": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final State"
    },
    "granted_capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Granted Capabilities",
      "type": "array"
    },
    "harness": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness"
    },
    "harness_implementation": {
      "anyOf": [
        {
          "enum": [
            "declared",
            "runnable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Harness Implementation"
    },
    "initial_state": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initial State"
    },
    "job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Trace Id"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "action": "#/$defs/ActionStep",
            "event": "#/$defs/Event",
            "llm": "#/$defs/LLMCall",
            "turn": "#/$defs/Turn"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/LLMCall"
          },
          {
            "$ref": "#/$defs/ActionStep"
          },
          {
            "$ref": "#/$defs/Event"
          },
          {
            "$ref": "#/$defs/Turn"
          }
        ]
      },
      "title": "Steps",
      "type": "array"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tags",
      "type": "object"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "terminated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminated"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "trace_kind": {
      "default": "production",
      "enum": [
        "production",
        "episode",
        "llm_call"
      ],
      "title": "Trace Kind",
      "type": "string"
    },
    "trial_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trial Id"
    },
    "truncated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Truncated"
    }
  },
  "title": "Plural Trace",
  "type": "object"
}
