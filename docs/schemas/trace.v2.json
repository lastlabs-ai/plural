{
  "$defs": {
    "ActionStep": {
      "description": "One action invocation and the observation it returned.",
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/ActionStep"
          },
          "title": "Children",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "observation": {
          "default": null,
          "title": "Observation"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "source": {
          "default": "environment_native",
          "enum": [
            "environment_native",
            "harness",
            "model_text"
          ],
          "title": "Source",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "type": {
          "const": "action",
          "default": "action",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ActionStep",
      "type": "object"
    },
    "Attempt": {
      "description": "A single provider attempt within an LLM call.\n\nAttributes:\n    model: Model id attempted.\n    provider: Provider slug.\n    error: Error message if failed.\n    latency_ms: Attempt latency.\n    status_code: HTTP status code if available.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        }
      },
      "required": [
        "model",
        "provider"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "AudioContent": {
      "description": "An audio content part.\n\nAttributes:\n    type: Discriminator; always ``\"input_audio\"``.\n    data: Base64-encoded audio bytes.\n    format: Audio format such as ``\"wav\"`` or ``\"mp3\"``.",
      "properties": {
        "data": {
          "title": "Data",
          "type": "string"
        },
        "format": {
          "default": "wav",
          "title": "Format",
          "type": "string"
        },
        "type": {
          "const": "input_audio",
          "default": "input_audio",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "data"
      ],
      "title": "AudioContent",
      "type": "object"
    },
    "CapabilityDenial": {
      "description": "A capability the environment or policy removed during a trial.",
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "layer",
        "reason"
      ],
      "title": "CapabilityDenial",
      "type": "object"
    },
    "ChatRequest": {
      "description": "A normalized chat completion request.\n\nAttributes:\n    model: Primary model id in ``author/slug`` form.\n    messages: Conversation messages.\n    models: Optional fallback model chain (tried in order after ``model``).\n    temperature: Sampling temperature.\n    top_p: Nucleus sampling parameter.\n    max_tokens: Maximum tokens to generate.\n    stop: Stop sequence(s).\n    tools: Tools available to the model.\n    tool_choice: Tool selection strategy or a forced tool.\n    response_format: Structured output request.\n    stream: Whether to stream the response.\n    seed: Deterministic seed when supported.\n    user: End-user identifier for abuse detection / analytics.\n    provider: Provider routing preferences.\n    metadata: Arbitrary request metadata propagated into traces.\n    extra: Provider-specific passthrough fields.\n\nExamples:\n    >>> ChatRequest(\n    ...     model=\"anthropic/claude-sonnet-4\",\n    ...     messages=[Message(role=\"user\", content=\"Hi\")],\n    ... ).temperature is None\n    True",
      "properties": {
        "extra": {
          "additionalProperties": true,
          "title": "Extra",
          "type": "object"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Messages",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "models": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Models"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderPreferences"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response_format": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "tool_choice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Choice"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tool"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        }
      },
      "required": [
        "model",
        "messages"
      ],
      "title": "ChatRequest",
      "type": "object"
    },
    "ChatResponse": {
      "description": "A normalized chat completion response.\n\nAttributes:\n    id: Provider-assigned completion id.\n    model: Model that produced the response (may differ from the request).\n    choices: Completion choices.\n    usage: Token usage and optional cost.\n    provider: Provider slug that served the request.\n    region: Region of the host that served it. The same provider charges\n        different rates per region, so billing needs both.\n    created: Unix timestamp when the completion was created.\n    raw: Original provider payload for debugging.\n    latency_ms: End-to-end latency in milliseconds.\n    attempts: Number of attempts (including retries/fallbacks) used.\n\nExamples:\n    >>> resp = ChatResponse(\n    ...     id=\"chatcmpl-1\",\n    ...     model=\"openai/gpt-4o-mini\",\n    ...     choices=[Choice(message=Message(role=\"assistant\", content=\"Hi\"))],\n    ... )\n    >>> resp.text\n    'Hi'",
      "properties": {
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        },
        "created": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "raw": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "id",
        "model",
        "choices"
      ],
      "title": "ChatResponse",
      "type": "object"
    },
    "Choice": {
      "description": "A single completion choice.\n\nAttributes:\n    index: Choice index.\n    message: The assistant message.\n    finish_reason: Why generation stopped.",
      "properties": {
        "finish_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinishReason"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "index": {
          "default": 0,
          "title": "Index",
          "type": "integer"
        },
        "message": {
          "$ref": "#/$defs/Message"
        }
      },
      "required": [
        "message"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Event": {
      "description": "A free-form event step.\n\nAttributes:\n    type: Discriminator; always ``\"event\"``.\n    name: Event name.\n    data: Arbitrary event payload.",
      "properties": {
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Event",
      "type": "object"
    },
    "FinishReason": {
      "description": "Why generation stopped.",
      "enum": [
        "stop",
        "length",
        "tool_calls",
        "content_filter",
        "error",
        "unknown"
      ],
      "title": "FinishReason",
      "type": "string"
    },
    "FunctionCall": {
      "description": "A function invocation requested by the model.\n\nAttributes:\n    name: Function name to call.\n    arguments: JSON-encoded argument object as a string.",
      "properties": {
        "arguments": {
          "title": "Arguments",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "FunctionCall",
      "type": "object"
    },
    "FunctionDefinition": {
      "description": "JSON-schema function definition for tool calling.\n\nAttributes:\n    name: Function name exposed to the model.\n    description: Human-readable description of the function.\n    parameters: JSON Schema object describing the parameters.\n    strict: Whether to request strict schema adherence when supported.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "strict": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strict"
        }
      },
      "required": [
        "name"
      ],
      "title": "FunctionDefinition",
      "type": "object"
    },
    "ImageContent": {
      "description": "An image content part (URL or base64 data URL).\n\nAttributes:\n    type: Discriminator; always ``\"image_url\"``.\n    url: HTTP(S) URL or ``data:`` URL for the image.\n    detail: Optional detail hint for vision models.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "low",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "type": {
          "const": "image_url",
          "default": "image_url",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "title": "ImageContent",
      "type": "object"
    },
    "LLMCall": {
      "description": "An LLM invocation step.\n\nAttributes:\n    type: Discriminator; always ``\"llm\"``.\n    request: The chat request (may be redacted).\n    response: The chat response (may be redacted).\n    provider: Winning provider slug.\n    model: Winning model id.\n    usage: Token usage.\n    cost: USD cost when known.\n    latency_ms: End-to-end latency.\n    attempts: All attempts including retries and fallbacks.\n    error: Top-level error if the call ultimately failed.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/Attempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatRequest"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatResponse"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "type": {
          "const": "llm",
          "default": "llm",
          "title": "Type",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LLMCall",
      "type": "object"
    },
    "Message": {
      "description": "A single chat message.\n\nAttributes:\n    role: Message role.\n    content: Text content, a list of content parts, or ``None`` when the\n        message only carries tool calls.\n    name: Optional participant name.\n    tool_calls: Tool calls requested by the assistant, if any.\n    tool_call_id: Id of the tool call this message responds to (tool role).\n    reasoning: Reasoning (\"thinking\") text the model produced before its\n        answer. Separate from ``content`` because callers usually render it\n        differently, and some hosts bill it as output tokens.\n    reasoning_signature: Host-issued attestation for ``reasoning``.\n        Anthropic and Bedrock reject a thinking block replayed without it,\n        so it has to survive a round trip.\n\nExamples:\n    >>> Message(role=\"user\", content=\"Hello\").role\n    'user'",
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TextContent"
                  },
                  {
                    "$ref": "#/$defs/ImageContent"
                  },
                  {
                    "$ref": "#/$defs/AudioContent"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "reasoning_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Signature"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "enum": [
                "system",
                "user",
                "assistant",
                "tool"
              ],
              "type": "string"
            }
          ],
          "title": "Role"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        },
        "tool_calls": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ToolCall"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        }
      },
      "required": [
        "role"
      ],
      "title": "Message",
      "type": "object"
    },
    "Outcome": {
      "description": "Labeled outcome attached to a trace.\n\nAttributes:\n    scores: Named scorer outputs.\n    reward: Scalar reward used for RL / ranking.\n    labels: Discrete labels (e.g. intent, success/fail).\n    feedback: Free-form human or automated feedback.",
      "properties": {
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        },
        "labels": {
          "additionalProperties": true,
          "title": "Labels",
          "type": "object"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        }
      },
      "title": "Outcome",
      "type": "object"
    },
    "ParsedAction": {
      "description": "A structured action the policy chose this turn.",
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "default": "environment_native",
          "enum": [
            "environment_native",
            "harness",
            "model_text"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ParsedAction",
      "type": "object"
    },
    "ProviderPreferences": {
      "description": "OpenRouter-compatible provider routing preferences.\n\nAttributes:\n    order: Provider slugs to try in order.\n    allow_fallbacks: Whether to allow backup providers.\n    require_parameters: Only use providers that support all request params.\n    data_collection: Whether to allow providers that may store data.\n    only: Allow-list of provider slugs.\n    ignore: Deny-list of provider slugs.\n    sort: Sort key such as ``\"price\"``, ``\"latency\"``, or ``\"throughput\"``.\n    max_price: Maximum price constraints for prompt/completion tokens.",
      "properties": {
        "allow_fallbacks": {
          "default": true,
          "title": "Allow Fallbacks",
          "type": "boolean"
        },
        "data_collection": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Collection"
        },
        "ignore": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ignore"
        },
        "max_price": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Price"
        },
        "only": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Only"
        },
        "order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "require_parameters": {
          "default": false,
          "title": "Require Parameters",
          "type": "boolean"
        },
        "sort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sort"
        }
      },
      "title": "ProviderPreferences",
      "type": "object"
    },
    "ReasoningBlock": {
      "description": "One chain-of-thought or assistant text block from a turn.",
      "properties": {
        "kind": {
          "enum": [
            "thinking",
            "text",
            "redacted"
          ],
          "title": "Kind",
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
